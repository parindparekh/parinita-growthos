APP_NAME=Parinita GrowthOS
# development | production. Production refuses weak keys and non-https PUBLIC_BASE_URL at startup.
ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:8080
BIND_ADDR=127.0.0.1

# --- credentials: the launchers replace each placeholder below with its own random secret ---
POSTGRES_PASSWORD=__GENERATE__
# Bootstrap admin key. In production it cannot record approvals.
API_KEY=__GENERATE__
# Named principals: name:role1|role2:key  (roles: admin, editor, approver, publisher, auditor)
# One key per person or system. Approvals are attributed to the principal name.
API_KEYS=approver1:approver:__GENERATE__
# Author of high-risk content may not approve it. Default: on in production.
# REQUIRE_FOUR_EYES=true

# --- single sign-on (OpenID Connect). Set issuer + client id to turn it on. ---
# Works with any OIDC provider (Okta, Entra ID, Keycloak, Google Workspace ...). Register the redirect URI
# <PUBLIC_BASE_URL>/auth/callback with the provider.
# Set to "witness" to use Parinita Witness (see docs/WITNESS.md). Empty = any OIDC provider.
IDENTITY_PROVIDER=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Claim that carries the user's groups/roles, and how those map to GrowthOS roles.
OIDC_ROLE_CLAIM=groups
# OIDC_ROLE_MAP={"Comms-Editors":["editor"],"Legal-Approvers":["approver","auditor"],"Platform-Admins":["admin"]}
# Signs the console session cookie. Required with OIDC. The launchers generate it.
SESSION_SECRET=__GENERATE__
SESSION_TTL_SECONDS=28800
# With SSO on, approvals/revocations/sentence waivers need an SSO identity (default true).
# APPROVAL_REQUIRES_SSO=true
# Set false to make SSO the only way in (no API keys at all).
API_KEYS_ENABLED=true

# --- egress policy ---
# Comma-separated host suffixes GrowthOS may call (feeds, webhooks, provider APIs). Empty = any public host.
# With providers in use, include their API hosts: api.linkedin.com, api.x.com, bsky.social,
# api.transistor.fm, www.buzzsprout.com, your Mastodon instance, your wire's endpoint.
DESTINATION_ALLOWLIST=
# Leave false. true permits loopback/private destinations (local testing only).
ALLOW_PRIVATE_DESTINATIONS=false
# Destination secrets referenced from endpoint config (any "*_env" key). Only GROWTHOS_SECRET_* can be referenced.
# GROWTHOS_SECRET_NEWSROOM_TOKEN=
# GROWTHOS_SECRET_NEWSROOM_SIGNING=
# GROWTHOS_SECRET_LINKEDIN_TOKEN=
# GROWTHOS_SECRET_X_CONSUMER_KEY=
# GROWTHOS_SECRET_X_CONSUMER_SECRET=
# GROWTHOS_SECRET_X_ACCESS_TOKEN=
# GROWTHOS_SECRET_X_ACCESS_TOKEN_SECRET=
# GROWTHOS_SECRET_MASTODON_TOKEN=
# GROWTHOS_SECRET_BLUESKY_APP_PASSWORD=
# GROWTHOS_SECRET_TRANSISTOR_KEY=
# GROWTHOS_SECRET_BUZZSPROUT_TOKEN=
# GROWTHOS_SECRET_WIRE_KEY=
# v1.7 destinations (see docs/PROVIDERS.md). Fixed API hosts to allow in DESTINATION_ALLOWLIST when used:
#   www.reddit.com oauth.reddit.com graph.facebook.com graph.threads.net api.pinterest.com open.tiktokapis.com api.tumblr.com
#   openapi.etsy.com mybusiness.googleapis.com dev.to api.buttondown.com <dc>.api.mailchimp.com chat.googleapis.com
# GROWTHOS_SECRET_REDDIT_CLIENT_SECRET=
# GROWTHOS_SECRET_REDDIT_REFRESH_TOKEN=
# GROWTHOS_SECRET_FACEBOOK_PAGE_TOKEN=
# GROWTHOS_SECRET_INSTAGRAM_TOKEN=
# GROWTHOS_SECRET_THREADS_TOKEN=
# GROWTHOS_SECRET_PINTEREST_TOKEN=
# GROWTHOS_SECRET_TIKTOK_TOKEN=
# GROWTHOS_SECRET_TUMBLR_TOKEN=
# GROWTHOS_SECRET_LEMMY_PASSWORD=
# GROWTHOS_SECRET_ETSY_TOKEN=
# GROWTHOS_SECRET_SHOPIFY_TOKEN=
# GROWTHOS_SECRET_GBP_TOKEN=
# GROWTHOS_SECRET_DEVTO_KEY=
# GROWTHOS_SECRET_GHOST_ADMIN_KEY=
# GROWTHOS_SECRET_BUTTONDOWN_KEY=
# GROWTHOS_SECRET_MAILCHIMP_KEY=
# GROWTHOS_SECRET_GOOGLE_CHAT_WEBHOOK_URL=
# GROWTHOS_SECRET_MATTERMOST_WEBHOOK_URL=
# GROWTHOS_SECRET_MATRIX_TOKEN=
# GROWTHOS_SECRET_ZULIP_KEY=

# Your own internal services that live on private addresses (Vaak, a Tapestry fabric, an internal MCP server).
# Host suffixes, comma-separated. Only these skip the public-address rule.
TRUSTED_INTERNAL_HOSTS=
# GROWTHOS_SECRET_SLACK_TOKEN=
# GROWTHOS_SECRET_TEAMS_WEBHOOK_URL=
# GROWTHOS_SECRET_DISCORD_WEBHOOK_URL=
# GROWTHOS_SECRET_TELEGRAM_BOT_TOKEN=
# GROWTHOS_SECRET_WHATSAPP_TOKEN=
# GROWTHOS_SECRET_WHATSAPP_RECIPIENTS=15551230001,15551230002
# GROWTHOS_SECRET_WORDPRESS_APP_PASSWORD=
# GROWTHOS_SECRET_MCP_TOKEN=
# GROWTHOS_SECRET_VAAK_TOKEN=

# --- Parinita Vaak audio ---
# Where rendered audio is kept and served from (/media). The compose file mounts a volume here.
MEDIA_DIR=/media

# --- MCP server (agents use GrowthOS through POST /mcp with the same keys / SSO tokens and roles) ---
MCP_ENABLED=true
# Extra browser origins allowed to call /mcp (PUBLIC_BASE_URL is always allowed).
MCP_ALLOWED_ORIGINS=

# --- gate policy ---
# Classes (in addition to investor/regulated/legal/health/financial) where uncovered numbers and
# quotations block release instead of warning.
GATE_EVIDENCE_CLASSES=pr,social
STRICT_NUMERIC=false
# Sentence accounting: every assertive sentence needs a supported claim or a reviewer's decision.
# block | warn | off. Blocks only in the evidence classes above; warns elsewhere.
GATE_SENTENCE_MODE=block
# Share of a sentence's content words that must appear in one supported claim to count as covered.
GATE_SENTENCE_MATCH=0.6
# Who may record "needs no evidence" on a sentence: approver | editor.
GATE_WAIVER_ROLE=approver

# --- API/feed rate limits (single-process defense in depth; use an edge limiter when scaled horizontally) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=240
PUBLIC_FEED_RATE_LIMIT_PER_MINUTE=600
# Per-source-address ceiling applied on top of the per-credential limit (bounds credential guessing / key spraying).
RATE_LIMIT_PER_IP_PER_MINUTE=600
# Behind a reverse proxy, name the proxy addresses whose X-Forwarded-For / X-Forwarded-Proto uvicorn may trust,
# otherwise every request appears to come from the proxy and shares one address bucket. Comma-separated, or "*"
# when the API port is reachable only from the proxy (the default compose binding).
# FORWARDED_ALLOW_IPS=172.16.0.0/12

# --- feed fabric ---
FEED_POLL_SECONDS=300
HTTP_TIMEOUT_SECONDS=20
MAX_FEED_BYTES=5000000
MAX_FEED_ENTRIES=500
PUSH_MAX_ATTEMPTS=3

# --- optional model gateway (OpenAI-compatible). Leave empty for deterministic agents. ---
TEXT_MODEL_BASE_URL=
TEXT_MODEL_API_KEY=
TEXT_MODEL_NAME=

# --- smtp ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Chrysalis external trust anchor. In production set CHRYSALIS_ENABLED=true and point this at the deployed
# Chrysalis v6 assurance ingress. Token values must live in GROWTHOS_SECRET_* variables, never endpoint config.
CHRYSALIS_ENABLED=false
CHRYSALIS_ANCHOR_URL=
CHRYSALIS_BEARER_TOKEN_ENV=GROWTHOS_SECRET_CHRYSALIS_TOKEN
GROWTHOS_SECRET_CHRYSALIS_TOKEN=
CHRYSALIS_FAIL_CLOSED_HIGH_RISK=true
CHRYSALIS_FAIL_CLOSED_ALL=false
CHRYSALIS_ANCHOR_INTERVAL_SECONDS=3600
# Receipt verification (REQUIRED when Chrysalis is enabled in production): require the receipt to echo the payload digest, and verify its
# signature with the Chrysalis receipt-signing public key (Ed25519 or ECDSA P-256, PEM; "\n" accepted for newlines).
# See docs/CHRYSALIS.md "Receipt verification".
CHRYSALIS_REQUIRE_RECEIPT_DIGEST=true
CHRYSALIS_RECEIPT_VERIFY_KEY=
CHRYSALIS_RECEIPT_SIGNATURE_FIELD=signature

# --- AEO probes ---
# Editors may point a probe at any operator-allowed URL; the only process secrets a probe may attach are these.
AEO_PROBE_SECRET_PREFIX=GROWTHOS_SECRET_AEO_
# GROWTHOS_SECRET_AEO_ENGINE_TOKEN=
